    "check:quick": "node scripts/check.mjs --quick"
  },
  "dependencies": {
    "jspdf": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.34.5",
    "vite": "^5.0.0"
  }
}
