{
  "name": "whiskedaway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-explore.mjs && vite build && node scripts/build-site.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler@latest deploy",
