/archive/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The Inn's renders, the door's picture and film, Gemma's sprites and the sounds are named files that rarely change:
# a returning visitor reuses them for a day instead of asking again (and gets a changed one within a week, in the background).
# Scripts, pages and JSON stay on revalidate: they change with every deploy and must match each other.
/explore/out/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/explore/explore/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
